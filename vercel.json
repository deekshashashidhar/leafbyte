{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/PlayByte.html", "destination": "/playbyte.html", "permanent": true },
    { "source": "/climate quest.html", "destination": "/climate-quest.html", "permanent": true },
    { "source": "/game mechanics.html", "destination": "/climate-quest.html", "permanent": true },
    { "source": "/case studies.html", "destination": "/learn.html#case-studies", "permanent": true },
    { "source": "/research papers.html", "destination": "/learn.html#papers", "permanent": true },
    { "source": "/more about sustainable tech.html", "destination": "/learn.html#basics", "permanent": true },
    { "source": "/green ai.html", "destination": "/learn.html#basics", "permanent": true },
    { "source": "/meet the heroes.html", "destination": "/heroes.html", "permanent": true },
    { "source": "/our team.html", "destination": "/about.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
